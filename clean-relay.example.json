{
  "listen": "127.0.0.1:17880",
  "upstream_origin": "https://upstream.example",
  "drop_input_fields": [
    "internal_chat_message_metadata_passthrough"
  ],
  "max_body_bytes": 33554432,
  "max_in_flight": 8,
  "response_header_timeout": "5m",
  "log_level": "info",
  "azure_resource_retry": {
    "enabled": false,
    "cleanup_mode": "portable_ids",
    "history_scope": "request",
    "session_diagnostics": false,
    "session_cache": {
      "idle_ttl": "2h",
      "max_sessions": 256,
      "max_items_per_session": 4096,
      "max_bytes": 67108864
    },
    "inspect_sse": true,
    "max_inspect_bytes": 65536,
    "inspect_timeout": "2s"
  }
}
